# Base de données (Supabase > Project Settings > Database > Connection string > Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Stockage des photos (Supabase > Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé "service_role" — jamais exposée au navigateur

# Mot de passe admin de premier démarrage (à changer ensuite depuis /admin)
ADMIN_INITIAL_PASSWORD=change-moi-avant-le-deploiement

# E-mail transactionnel (optionnel — laissez vide pour désactiver l'envoi d'e-mails)
RESEND_API_KEY=
MAIL_FROM=
